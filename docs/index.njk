permalink: /index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Documentation — The Roving Office</title>
  <meta name="description" content="The Roving Office documentation: one door for people using it, one for people changing it." />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/png" href="/assets/icon-192.png" sizes="192x192" />
  <link rel="preload" href="{{ '/assets/Inter-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="{{ '/assets/ui-theme.css' | url }}" />
  <link rel="stylesheet" href="{{ '/assets/docs.css' | url }}" />
</head>
<body>
  {# The landing page has no sidebar, because it has nothing to be a sidebar of: it is the
     one page whose only job is to send you through one of the two doors. It reuses the
     stylesheet rather than carrying its own, so the palette cannot drift. #}
  <header class="topbar">
    <a class="brand" href="/">
      <img src="/assets/logo-64.png" alt="" width="26" height="26" />
      <span>The Roving Office</span>
    </a>
  </header>

  <main class="doorway">
    <p class="doorway-eyebrow">The office handbook</p>
    <h1>Make yourself at home.</h1>
    <p class="lede">
      Find your feet, bring your agents along, or make something new for the room.
      Everything you need to get comfortable is here.
    </p>

    <div class="doors">
      {%- for s in sections %}
      <a class="door" href="{{ s.href | url }}">
        <img class="door-spot" src="/assets/{% if s.id == 'user' %}arrivals{% else %}curiosity{% endif %}.svg" alt="" width="112" height="80" />
        <h2>{{ s.label }}</h2>
        <p>{{ s.tagline }}</p>
        <ul>
          {%- for group in nav[s.id] %}{% if loop.index <= 3 %}
          <li>{{ group.label }}</li>
          {%- endif %}{% endfor %}
          <li>…</li>
        </ul>
        <span class="go">Open →</span>
      </a>
      {%- endfor %}
    </div>

    <p class="aside-note">
      In a hurry? <a href="{{ '/user/watching.html' | url }}">Watching the office</a> is two
      minutes and needs nothing installed. Or just
      <a href="/office/TEST-0000">open the demo office</a> and have a look.
    </p>

{# Generated by `npm run shot`, like every other picture in these docs, so it cannot
       quietly stop resembling the product. #}
    <figure class="hero">
      <img src="/docs/images/screens/office.png" width="875" height="700"
           alt="An isometric cutaway office on a street corner: characters at work, some seated at desks with lit monitors, one walking across the floor, a coffee machine, a bookshelf with a globe, a telescope at the window and a printer by the wall." />
{# No headcount in the caption: this picture is regenerated, and the room fills
         and empties on its own, so any number written here would be wrong by the next
         run of `npm run shot`. #}
      <figcaption>
        A little world of work. Explore it with simulated agents, or bring your own.
      </figcaption>
    </figure>

    <h2 class="libs-heading">The library pages</h2>
    <p>
      Three generated pages that are more fun than prose, and are also how a change gets
      checked.
    </p>
    <ul class="libs">
      <li><a href="{{ '/character-movements.html' | url }}">Every character movement</a>, looping, one to a card</li>
      <li><a href="{{ '/item-movements.html' | url }}">Every object in the room</a>, on a turntable</li>
      <li><a href="{{ '/office-seeds.html' | url }}">Two dozen generated offices</a>, with their names and their reasons</li>
    </ul>
  </main>

  <footer class="footer">
    <p class="wink">It's very alpha. It was written mostly on a plane.</p>
  </footer>
</body>
</html>
